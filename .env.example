# client
NUXT_PUBLIC_API_BASE=

# auth (Better Auth runs in the Nuxt app; FastAPI verifies its tokens)
# client: secret used to sign sessions (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# client + server: public URL of the Nuxt app (server uses it for JWKS and api-key checks)
BETTER_AUTH_URL=http://localhost:3000
# client + server: shared secret for the server-to-server api-key check
INTERNAL_API_SECRET=
BETTER_AUTH_INTERNAL_SECRET=
# client: auth database (Turso). Leave unset in dev to use a local file (client/auth.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# server
CLIENT_URL=
# server: app data in Turso (a separate database from the auth one).
# Leave both unset in dev to use the local SQLite file.
TURSO_APP_DATABASE_URL=
TURSO_APP_AUTH_TOKEN=

# ml_model
MLFLOW_TRACKING_URI=
MLFLOW_ARTIFACT_PATH=
MLFLOW_EXPERIMENT_PATH=
MLFLOW_EXPERIMENT_NAME=
MLFLOW_MODEL_NAME=
MLFLOW_MODEL_VERSION=

DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Docker Compose
COMPOSE_BAKE=

# Africa's Talking
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=